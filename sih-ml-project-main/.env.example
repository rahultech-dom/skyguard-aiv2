# ==============================================================================
# SkyGuard AI v2 — Backend Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or credentials to git.

# ── SMTP Email Alert Dispatcher ──────────────────────────────────────────────
# SMTP server host (default: smtp.gmail.com)
SMTP_SERVER=smtp.gmail.com

# SMTP port (default: 587 for STARTTLS)
SMTP_PORT=587

# Sender email address / Gmail username
SMTP_USER=your_email@gmail.com

# Sender SMTP password or Gmail App Password (16 characters, no spaces)
# Note: For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_gmail_app_password

# Primary recipient email for automated anomaly alerts (supports comma-separated emails)
ALERT_RECIPIENT_EMAIL=maintenance_team@domain.com

# In-memory per-station anti-spam cooldown window in seconds (default: 180s = 3 min)
ALERT_COOLDOWN_SECONDS=180

# ── LangGraph GenAI Diagnostics (Optional) ───────────────────────────────────
# Groq API Key for LLM-powered incident root cause narration
# If not provided, SkyGuard AI automatically utilizes deterministic physical narration fallback.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
