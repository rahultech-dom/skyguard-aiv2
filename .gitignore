# SkyGuard AI v2 — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
.eggs/
.env
.venv/
venv/
env/

# Models (large binary — regenerated on deploy via fetch_historical.py + warm_up)
sih-ml-project-main/ml/models/*.pkl
sih-ml-project-main/models/*.pkl
sih-ml-project-main/ml/outputs/

# Data (large — regenerated on deploy)
# IMPORTANT: DO NOT gitignore weather_data_real.csv if your deploy server can't run fetch
# Uncomment below only if Render has internet access during build (it does):
sih-ml-project-main/data/weather_data_real.csv

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
