# Environment Variables — SkyGuard AI v2

# ── Backend (sih-ml-project-main/.env) ───────────────────────────────────────

# Groq API Key for LangGraph LLM narration
# Get one free at: https://console.groq.com
# If omitted, backend uses deterministic fallback (no crash)
GROQ_API_KEY=your_groq_api_key_here

# ── Frontend (frontend/.env.local) ────────────────────────────────────────────

# URL of deployed FastAPI backend
# For local dev: leave blank (defaults to http://127.0.0.1:8000)
# For deployed: set to your Render URL
VITE_API_URL=https://your-skyguard-backend.onrender.com
